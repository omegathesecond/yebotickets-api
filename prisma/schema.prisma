generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  organizer
  admin
}

enum TicketStatus {
  available
  sold
  reserved
  cancelled
}

enum TicketTypeEnum {
  standard
  vip
  early_bird
  group
}

enum PayoutMethod {
  bank_transfer
  mobile_money
}

enum PayoutRequestStatus {
  pending
  paid
  rejected
}

model User {
  id          String   @id @default(uuid())
  name        String
  phoneNumber String   @unique
  email       String?  @unique
  password    String?
  role        UserRole @default(user)
  isVerified  Boolean  @default(false)
  
  // OTP fields
  otpCode     String?
  otpExpiresAt DateTime?
  // Count of consecutive failed verify-otp attempts for the current code.
  // Reset to 0 whenever a new OTP is issued or a verification succeeds; once it
  // reaches the lockout threshold the code is invalidated and a new one must be
  // requested. Guards against brute-forcing the 6-digit code.
  otpAttempts Int      @default(0)

  // Password-reset fields (organizer/staff email+password recovery).
  // Kept separate from the OTP columns so a phone-login OTP and an email/phone
  // password-reset can be in flight at the same time without clobbering each
  // other. resetCodeHash stores a bcrypt hash of the code (never the code
  // itself) so a leaked User row can't be used to reset the password directly.
  // The code is single-use: it is cleared once a reset succeeds.
  // resetCodeAttempts caps brute-force guessing — the code is burned after a
  // small number of wrong attempts.
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  resetCodeAttempts  Int       @default(0)

  // Organizer profile (flattened)
  companyName      String?
  companyDescription String?
  website          String?
  
  // Social media
  socialFacebook   String?
  socialTwitter    String?
  socialInstagram  String?
  socialLinkedin   String?
  
  // Address
  addressStreet    String?
  addressCity      String?
  addressState     String?
  addressZipCode   String?
  addressCountry   String?

  // Payout method (how the organizer wants to receive withdrawals). All
  // nullable/optional — an organizer only fills these in once they intend to
  // request a payout; validated at the service layer against `payoutMethod`.
  payoutMethod             PayoutMethod?
  payoutBankName           String?
  payoutBankAccountName    String?
  payoutBankAccountNumber  String?
  payoutBankBranch         String?
  payoutMobileProvider     String?
  payoutMobileNumber       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  events      Event[]
  tickets     Ticket[]
  payoutRequests PayoutRequest[]

  @@index([phoneNumber])
  @@index([email])
}

model PayoutRequest {
  id            String               @id @default(uuid())

  organizerId   String
  organizer     User                 @relation(fields: [organizerId], references: [id])

  // Snapshot of what was requested; the source of truth for "available
  // balance" stays the real ticket-sales earnings calculation (see
  // organizer-event.service.ts getOrganizerEarnings) minus PENDING/PAID
  // requests — this row never itself becomes the money figure elsewhere.
  amount        Float
  status        PayoutRequestStatus  @default(pending)

  requestedAt   DateTime             @default(now())
  processedAt   DateTime?
  adminNote     String?

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([organizerId])
  @@index([status])
}

model Event {
  id           String   @id @default(uuid())
  title        String
  description  String
  
  // Location
  locationAddress     String
  locationCity        String
  locationCountry     String
  locationLat         Float?
  locationLng         Float?
  
  startDate    DateTime
  endDate      DateTime
  
  organizerId  String
  organizer    User     @relation(fields: [organizerId], references: [id])
  
  isPublished  Boolean  @default(false)
  coverImage   String?
  category     String

  // Cancellation: an organizer/admin can cancel an event, which refunds every
  // sold ticket via YeboPay and marks each CANCELLED. isCancelled gates the
  // operation idempotently (re-running only picks up tickets not yet handled);
  // cancelledAt records when the event was cancelled.
  isCancelled  Boolean  @default(false)
  cancelledAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  ticketTypes  TicketType[]
  tickets      Ticket[]
  
  @@index([organizerId])
  @@index([startDate, endDate])
  @@index([locationCity, locationCountry])
  @@index([category])
}

model TicketType {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Float
  quantity      Int
  
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  type          TicketTypeEnum @default(standard)
  saleStartDate DateTime
  saleEndDate   DateTime
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Relations
  tickets       Ticket[]
  
  @@index([eventId])
}

model Ticket {
  id            String       @id @default(uuid())
  
  ticketTypeId  String
  ticketType    TicketType   @relation(fields: [ticketTypeId], references: [id])
  
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  
  status        TicketStatus @default(available)
  purchaseDate  DateTime?
  uniqueCode    String       @unique
  isCheckedIn   Boolean      @default(false)
  checkedInAt   DateTime?

  // When the row was put into the 'reserved' hold (set on every reserve, cleared
  // back to null on release/finalize). Used to find reservations that have sat
  // unconfirmed past the TTL so an async (mobile-money PENDING) charge that never
  // settles cannot strand inventory forever. Nullable: only reserved rows have it.
  reservedAt    DateTime?

  // YeboPay charge reference, persisted when the ticket is sold. Nullable: free
  // (price 0) and unsold tickets have none. paymentRef is the YeboPay charge id
  // used for reconciliation/refunds; paymentStatus is its status at sale time
  // (SUCCEEDED for a paid ticket, FREE for a price-0 ticket); amountPaid is what
  // was actually charged (0 for free tickets).
  paymentRef    String?
  paymentStatus String?
  amountPaid    Float?

  // Refund / cancellation outcome, persisted when a sold ticket is refunded
  // (individually or because its event was cancelled). status flips to
  // CANCELLED and paymentStatus to REFUNDED ONLY after YeboPay confirms the
  // money is back. refundRef is the YeboPay refund/charge reference; refundedAt
  // records when the money was returned; cancelledAt records when the ticket
  // was voided (set for free tickets too, which are cancelled without a refund).
  refundRef     String?
  refundedAt    DateTime?
  cancelledAt   DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([eventId, status])
  @@index([userId])
  @@index([uniqueCode])
  @@index([ticketTypeId])
}
