PORT=5001
NODE_ENV=development

# PostgreSQL Database (Cloud SQL)
# For local dev with Cloud SQL proxy:
DATABASE_URL="postgresql://eneza_admin:PASSWORD@localhost:5439/yebotickets"
# For Cloud Run (use socket connection):
# DATABASE_URL="postgresql://eneza_admin:PASSWORD@localhost/yebotickets?host=/cloudsql/eneza-40ab5:europe-west1:eneza-postgres"

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# WhatsApp API Credentials
WHATSAPP_API_TOKEN=your_whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Dashboard API Key (for CEO Dashboard integration)
DASHBOARD_API_KEY=your_dashboard_api_key_here
