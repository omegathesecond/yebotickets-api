PORT=5001
NODE_ENV=development

# PostgreSQL Database (Cloud SQL)
# For local dev with Cloud SQL proxy:
DATABASE_URL="postgresql://eneza_admin:PASSWORD@localhost:5439/yebotickets"
# For Cloud Run (use socket connection):
# DATABASE_URL="postgresql://eneza_admin:PASSWORD@localhost/yebotickets?host=/cloudsql/eneza-40ab5:europe-west1:eneza-postgres"

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# YeboLink (canonical Omevision comms gateway — api.yebolink.com)
# All SMS/WhatsApp/email (OTP + ticket delivery) is sent through YeboLink.
# Provisioned per product, per env. Bound from Secret Manager
# (YEBOTICKETS__YEBOLINK_API_KEY[_DEV]).
YEBOLINK_API_KEY=ybk_your_yebolink_api_key_here
# Optional; defaults to https://api.yebolink.com
# YEBOLINK_BASE_URL=https://api.yebolink.com

# Dashboard API Key (for CEO Dashboard integration)
DASHBOARD_API_KEY=your_dashboard_api_key_here

# YeboPay (canonical Omevision payments gateway — api.yebopay.com)
# Provisioned per product, per env. Bound from Secret Manager
# (YEBOTICKETS__YEBOPAY_API_KEY[_DEV]).
YEBOPAY_API_KEY=ypk_your_yebopay_api_key_here
# Optional; defaults to https://api.yebopay.com
# YEBOPAY_BASE_URL=https://api.yebopay.com
# Webhook signing secret — the yebotickets merchant's webhookSecret in YeboPay.
# Used to verify POST /api/payments/webhook deliveries. Bound from Secret
# Manager (YEBOTICKETS__YEBOPAY_WEBHOOK_SECRET[_DEV]).
YEBOPAY_WEBHOOK_SECRET=your_yebopay_webhook_secret_here

# Cloudflare R2 (S3-compatible) — hosts the ticket QR PNG at a PUBLIC URL so it
# can be attached to the WhatsApp ticket message via YeboLink media_urls (which
# takes public URLs, not buffers). Per env (dev/prod) bucket. Bound from Secret
# Manager (R2_ACCESS_KEY_ID[_DEV], R2_SECRET_ACCESS_KEY[_DEV], …). If unset,
# WhatsApp ticket delivery fails loudly and falls back to email (QR inline).
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# S3 API endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_NAME=yebotickets-media
# Public base URL objects are served at (custom domain, e.g. cdn.yebotickets.com)
R2_PUBLIC_URL=https://cdn.yebotickets.com

# Reservation reclaim timers (ms). A reserved seat whose async (mobile-money)
# charge hasn't confirmed past TTL is polled against YeboPay; one still PENDING
# past HARD_EXPIRY is reclaimed. Defaults: 15min TTL, 60min hard expiry.
# RESERVATION_TTL_MS=900000
# RESERVATION_HARD_EXPIRY_MS=3600000
